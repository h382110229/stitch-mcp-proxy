{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stitch-mcp-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "stitch.your-domain.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
